# Environment Variables
NODE_ENV=development

# Prisma
DATABASE_URL="file:./dev.db"

# Session Secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-with-64-char-secret

# Lab 主機
LAB_HOST=
LAB_PORT=8080
LAB_SSH_USER=
# 部署後公開網址
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Medical portfolio user password (legacy jasladmin)
MEDICAL_PORTFOLIO_PASSWORD="your-secure-password"

# 新後台預設管理員（首次啟動自動建立）
PORTAL_ADMIN_USER=your-admin-user
PORTAL_ADMIN_PASSWORD=your-secure-password

# 備份目的地（未設定時預設為專案 data/backups/local 與 data/backups/cloud）
BACKUP_ROOT=
BACKUP_CLOUD_DIR=

# Lizard patch 影像（未設定時預設 data/lizard-patches）
# LIZARD_PATCH_IMAGES_ROOT=

# Mpox dataset root (Augmented Images parent folder)
MPOX_DATASET_ROOT=

# Google Drive API — 直接讀雲端 WSI 實驗（lizard 最佳超參數）
# 建立方式：Google Cloud Console → APIs → Drive API → 建立 API 金鑰
# 資料夾需設為「知道連結的任何人」可檢視
GOOGLE_DRIVE_API_KEY=""
GOOGLE_DRIVE_WSI_ROOT_FOLDER_ID="1k3oCXPchJL6IRj_5vAb5BBivjHt10gZZ"

# AI 建議（分析頁）— Cursor / GPT / Gemini
# Cursor：https://cursor.com → Settings → API Keys
CURSOR_API_KEY=""
CURSOR_MODEL="composer-2.5"
# OpenAI / GPT
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Google Gemini（Gemini 與 Google AI 搜尋模式共用）
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# Token 每日上限（超過 70% 前台顯示「已達到當日限制」）
# AI_DAILY_TOKEN_LIMIT_CURSOR=500000
# AI_DAILY_TOKEN_LIMIT_OPENAI=200000
# AI_DAILY_TOKEN_LIMIT_GEMINI=250000
# AI_DAILY_TOKEN_LIMIT_GOOGLE_AI=250000